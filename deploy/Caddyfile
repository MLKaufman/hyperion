{$PORTAL_HOST} {
    handle_path /static/* {
        root * /srv/static
        file_server
    }
    handle {
        reverse_proxy app:8000 {
            header_up X-Real-IP {remote_host}
        }
    }
}

https://{$REPORT_HOST_PATTERN} {
    tls /certs/fullchain.pem /certs/privkey.pem
    reverse_proxy app:8000 {
        header_up X-Real-IP {remote_host}
    }
}
