# Copy to .env, generate a long random SECRET_KEY, and set these values.
SECRET_KEY=
PORTAL_ORIGIN=https://portal.example.org
REPORT_ORIGIN_TEMPLATE=https://pi-{pi}.reports.example.org
PORTAL_HOST=portal.example.org
REPORT_HOST_PATTERN=*.reports.example.org
REPORTS_HOST_PATH=./sample_reports
CERTS_HOST_PATH=./certs
MAX_DELIVERABLE_BYTES=268435456
SCAN_INTERVAL=60
