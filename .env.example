# Only the report folder needs changing for a local deployment.
REPORTS_HOST_PATH=./sample_reports
PUBLIC_URL=http://localhost:8000
HYPERION_PORT=8000
HYPERION_BIND=127.0.0.1
# Leave empty for direct access; the seq-space deployment supplies proxy trust.
TRUSTED_PROXY_CIDRS=
MAX_DELIVERABLE_BYTES=268435456
SCAN_INTERVAL=60
# Secret and initial administrator are generated automatically in /data.
